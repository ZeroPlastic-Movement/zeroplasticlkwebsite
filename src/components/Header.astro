---
/**
 * Site header.
 *
 * Uses the official ZeroPlastic Movement wordmark from the WordPress media
 * library, unaltered. The mobile menu is a pure-CSS disclosure, so the header
 * still ships no JavaScript.
 */
import { ALERT_URL, NAV, SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
      <img
        src="/images/zeroplastic-logo.png"
        width="300"
        height="130"
        alt={SITE.name}
        decoding="sync"
        fetchpriority="high"
      />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle__label">
      <span aria-hidden="true"></span>
      <span class="visually-hidden">Toggle navigation</span>
    </label>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav__actions">
          <a class="link-report" href={ALERT_URL}>Report pollution</a>
          <a class="button button--sm" href="/volunteers/">Volunteer</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgb(255 255 255 / 88%);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
  }
  /* The asset is 300x130; rendering at 132px keeps it crisp on retina. */
  .brand img {
    width: 132px;
    height: auto;
  }

  .nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin: 0;
    padding: 0;
  }
  .nav a {
    text-decoration: none;
    color: var(--ink-700);
    font-weight: 550;
    font-size: 0.94rem;
    letter-spacing: -0.005em;
  }
  .nav a:hover {
    color: var(--green-600);
  }
  .nav a[aria-current='page'] {
    color: var(--ink-900);
    font-weight: 650;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--border);
  }
  .link-report {
    white-space: nowrap;
  }
  .link-report::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #d9484b;
    margin-right: 0.45rem;
    vertical-align: 0.05em;
  }

  .nav-toggle,
  .nav-toggle__label {
    display: none;
  }

  @media (max-width: 56rem) {
    .nav-toggle__label {
      display: block;
      cursor: pointer;
      padding: 0.6rem;
      border: 1px solid var(--border);
      border-radius: 10px;
    }
    .nav-toggle__label span[aria-hidden] {
      display: block;
      width: 1.15rem;
      height: 2px;
      background: var(--ink-900);
      box-shadow: 0 6px 0 var(--ink-900), 0 -6px 0 var(--ink-900);
    }
    .nav {
      display: none;
      width: 100%;
      padding-bottom: 1.1rem;
    }
    .nav-toggle:checked ~ .nav {
      display: block;
    }
    .nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .nav__actions {
      flex-direction: column;
      align-items: flex-start;
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--border);
      padding-top: 1rem;
      width: 100%;
    }
  }
</style>
