---
/**
 * Site footer.
 *
 * Doubles as the map of the wider ZeroPlastic ecosystem: the external
 * platforms each have their own site, and this is where they are all visible
 * in one place.
 */
import { CONTACT, EXTERNAL, SITE, SOCIAL } from '../consts';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'About',
    links: [
      { label: 'About ZeroPlastic', href: '/about/' },
      { label: 'Our work', href: '/our-work/' },
      { label: 'Advocacy', href: '/advocacy/' },
      { label: 'The problem', href: '/problem-statement/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
  {
    heading: 'Get involved',
    links: [
      { label: 'Volunteer', href: '/volunteers/' },
      { label: 'International volunteers', href: '/volunteers/#international' },
      { label: 'ZeroPlastic Clubs', href: '/clubs/' },
      { label: 'Start a club', href: EXTERNAL.clubForm, external: true },
      { label: 'Register a school club', href: EXTERNAL.schoolClubForm, external: true },
      { label: 'Partner with us', href: '/contact/' },
    ],
  },
  {
    heading: 'Initiatives',
    links: [
      { label: 'ZeroPlastic Commitment', href: EXTERNAL.commitment, external: true },
      { label: 'Volunteers Academy', href: EXTERNAL.volunteersAcademy, external: true },
      { label: 'Impact Center', href: EXTERNAL.impactCenter, external: true },
      { label: 'Sustainable travel', href: '/sustainable-travel/' },
      { label: 'Travel Without Plastic', href: EXTERNAL.travellerPledge, external: true },
    ],
  },
  {
    heading: 'Stories',
    links: [
      { label: 'Latest projects', href: '/blog/' },
      { label: 'RSS feed', href: '/rss.xml' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <p class="site-footer__name">{SITE.name}</p>
        <p class="site-footer__tagline">{SITE.tagline}</p>
        <address>
          {CONTACT.address.name}<br />
          {CONTACT.address.street}<br />
          {CONTACT.address.locality}, {CONTACT.address.country}
        </address>
        <p class="site-footer__contact">
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a><br />
          <a href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a>
        </p>
      </div>

      <nav class="site-footer__cols" aria-label="Footer">
        {
          columns.map((col) => (
            <div>
              <h2>{col.heading}</h2>
              <ul>
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
                      target={'external' in link && link.external ? '_blank' : undefined}
                    >
                      {link.label}
                      {'external' in link && link.external && (
                        <span class="ext" aria-label="(opens an external site)">↗</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="site-footer__social">
      <h2>Follow the movement</h2>
      <ul>
        {
          SOCIAL.map((item) => (
            <li>
              <a href={item.url} rel="noopener noreferrer me" target="_blank">
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="site-footer__legal">
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <p>
        <a href="/privacy-policy/">Privacy policy</a> ·
        <a href="/terms-conditions/">Terms &amp; conditions</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-900);
    color: #c6d4cb;
    margin-top: 0;
    padding-top: clamp(2.75rem, 6vw, 4rem);
  }

  .site-footer__top {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(min(100%, 16rem), 20rem) 1fr;
    padding-bottom: 2.5rem;
  }
  @media (max-width: 60rem) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }
  }

  .site-footer__cols {
    display: grid;
    gap: 2rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
  }

  .site-footer h2 {
    color: #fff;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    margin-bottom: 0.85rem;
  }
  .site-footer__name {
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.15rem;
  }
  .site-footer__tagline {
    color: var(--green-400);
    margin-bottom: 1rem;
  }
  .site-footer address {
    font-style: normal;
    font-size: 0.88rem;
    line-height: 1.7;
    margin-bottom: 0.9rem;
  }
  .site-footer__contact {
    font-size: 0.88rem;
    line-height: 1.8;
    margin: 0;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer li {
    margin-bottom: 0.5rem;
  }
  .site-footer a {
    color: #c6d4cb;
    text-decoration: none;
    font-size: 0.89rem;
  }
  .site-footer a:hover {
    color: var(--green-400);
    text-decoration: underline;
  }
  .ext {
    font-size: 0.72em;
    opacity: 0.6;
    margin-left: 0.25em;
  }

  .site-footer__social {
    border-top: 1px solid rgb(255 255 255 / 12%);
    padding-block: 1.5rem;
  }
  .site-footer__social ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
  }
  .site-footer__social li {
    margin: 0;
  }

  .site-footer__legal {
    border-top: 1px solid rgb(255 255 255 / 12%);
    padding-block: 1.25rem;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.84rem;
  }
  .site-footer__legal p {
    margin: 0;
  }
</style>
