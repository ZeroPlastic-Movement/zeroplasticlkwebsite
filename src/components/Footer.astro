---
import { CONTACT, NAV, SITE, SOCIAL } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__brand">{SITE.name}</p>
      <p class="site-footer__tagline">{SITE.tagline}</p>
      <address>
        {CONTACT.address.name}<br />
        {CONTACT.address.street}<br />
        {CONTACT.address.locality}, {CONTACT.address.country}
      </address>
    </div>

    <div>
      <h2>Explore</h2>
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2>Get in touch</h2>
      <ul>
        <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
        <li><a href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a></li>
      </ul>

      <h2>Follow</h2>
      <ul class="site-footer__social">
        {
          SOCIAL.map((item) => (
            <li>
              <a href={item.url} rel="noopener noreferrer me" target="_blank">
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p>&copy; {year} {SITE.name}. All rights reserved.</p>
    <p>
      <a href="/privacy-policy/">Privacy policy</a> ·
      <a href="/terms-conditions/">Terms &amp; conditions</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-900);
    color: #cfdcd3;
    margin-top: 3rem;
    padding-top: 3rem;
  }
  .site-footer__inner {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    padding-bottom: 2rem;
  }
  .site-footer h2 {
    color: #fff;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }
  .site-footer__brand {
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.15rem;
  }
  .site-footer__tagline {
    color: var(--green-400);
    margin-bottom: 1rem;
  }
  .site-footer address {
    font-style: normal;
    font-size: 0.9rem;
    line-height: 1.7;
  }
  .site-footer ul {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .site-footer li {
    margin-bottom: 0.45rem;
  }
  .site-footer a {
    color: #cfdcd3;
    text-decoration: none;
    font-size: 0.92rem;
  }
  .site-footer a:hover {
    color: var(--green-400);
    text-decoration: underline;
  }
  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .site-footer__social li {
    margin: 0;
  }
  .site-footer__legal {
    border-top: 1px solid rgb(255 255 255 / 12%);
    padding-block: 1.25rem;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .site-footer__legal p {
    margin: 0;
  }
</style>
