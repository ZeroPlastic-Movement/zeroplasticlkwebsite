---
/**
 * Urgent contact strip for the confirmation pages.
 *
 * Someone who has just submitted a form and still needs an answer should not
 * have to navigate to /contact/ to find a number.
 *
 * This is the same line consts.ts already publishes through the footer and
 * /contact/: CONTACT.phoneHref is +94716901094, identical digits. Only the
 * grouping shown differs, because the brief for these pages asks for
 * +94 71 690 1094. The link and the WhatsApp number are therefore derived from
 * the constant rather than duplicated, so the two cannot drift apart. What is
 * urgent here is the route, not a separate number, and the copy says nothing
 * to suggest otherwise.
 */
import { CONTACT } from '../consts';

interface Props {
  heading: string;
}

const { heading } = Astro.props;

/** Grouping requested for these pages. Same digits as CONTACT.phone. */
const PHONE_DISPLAY = '+94 71 690 1094';
const WHATSAPP = `https://wa.me/${CONTACT.phoneHref.replace(/\D/g, '')}`;
---

<div class="direct">
  <p class="direct__tag">Urgent contact</p>
  <h2 class="direct__heading">{heading}</h2>

  <p class="direct__line">
    Call or WhatsApp:
    <a href={`tel:${CONTACT.phoneHref}`}>{PHONE_DISPLAY}</a>
  </p>

  <p class="direct__actions">
    <a class="button button--ghost" href={`tel:${CONTACT.phoneHref}`}>Call now</a>
    <a class="button" href={WHATSAPP} rel="noopener noreferrer" target="_blank">
      Open WhatsApp
    </a>
  </p>

  <p class="direct__email">
    Email <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
  </p>
</div>

<style>
  /* The blue is the same water accent as the hero, used here only as a left
     rule so the card reads as the fastest way to reach a person rather than as
     one more section. Everything else stays on the site's own card treatment. */
  .direct {
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-left: 4px solid #2f7fa3;
    border-radius: var(--radius);
    padding: clamp(1.4rem, 4vw, 2.1rem);
  }

  .direct__tag {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
    font-weight: 700;
    color: #123f57;
    margin: 0 0 0.5rem;
  }

  .direct__heading {
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.5rem);
    margin-bottom: 0.6rem;
  }

  /* The number itself, not the buttons, is the thing to read first. */
  .direct__line {
    margin: 0 0 1.15rem;
    font-size: 1.05rem;
    color: var(--ink-700);
  }
  .direct__line a {
    font-weight: 700;
    color: var(--ink-900);
    white-space: nowrap;
  }

  .direct__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }
  /* Below the smallest common phone width the two buttons cannot sit side by
     side without their labels wrapping, so they stack. */
  @media (max-width: 26rem) {
    .direct__actions {
      display: grid;
    }
  }

  .direct__email {
    margin: 1rem 0 0;
    font-size: 0.93rem;
    color: var(--ink-500);
  }
  /* A long address must never push the card wider than the page. */
  .direct__email a {
    overflow-wrap: anywhere;
  }
</style>
