---
/**
 * Project/news card.
 *
 * Every image carries explicit width/height (so nothing shifts as it loads),
 * a srcset built from the sizes WordPress already generated, and lazy loading
 * below the fold. The current site ships 37 of 43 homepage images without lazy
 * loading and 30 without dimensions.
 */
import type { WPPost } from '../lib/wp';

interface Props {
  post: WPPost;
  /** Set on above-the-fold cards so the browser loads them immediately. */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;

const published = new Date(post.date);
const displayDate = published.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<article class="card post-card">
  {
    post.image && (
      <a href={`/${post.slug}/`} class="post-card__media" tabindex="-1" aria-hidden="true">
        <img
          src={post.image.src}
          srcset={post.image.srcset}
          sizes="(max-width: 40rem) 100vw, (max-width: 72rem) 50vw, 22rem"
          width={post.image.width}
          height={post.image.height}
          alt=""
          loading={eager ? 'eager' : 'lazy'}
          decoding={eager ? 'sync' : 'async'}
          fetchpriority={eager ? 'high' : 'auto'}
        />
      </a>
    )
  }

  <div class="post-card__body">
    {post.categories.length > 0 && <p class="eyebrow">{post.categories[0]}</p>}

    <h3 class="post-card__title">
      <a href={`/${post.slug}/`}>{post.title}</a>
    </h3>

    <p class="post-card__excerpt">{post.excerpt.slice(0, 155)}{post.excerpt.length > 155 ? '…' : ''}</p>

    <p class="post-card__meta">
      <time datetime={post.date}>{displayDate}</time>
      <span aria-hidden="true">·</span>
      <span>{post.readingMinutes} min read</span>
    </p>
  </div>
</article>

<style>
  .post-card__media {
    display: block;
    background: var(--surface-alt);
  }
  .post-card__media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .post-card__body {
    padding: 1.15rem 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .post-card__title {
    font-size: 1.08rem;
    line-height: 1.35;
    margin-bottom: 0.55rem;
  }
  .post-card__title a {
    color: var(--ink-900);
    text-decoration: none;
  }
  .post-card__title a:hover {
    color: var(--green-600);
    text-decoration: underline;
  }
  .post-card__excerpt {
    font-size: 0.93rem;
    color: var(--ink-500);
    margin-bottom: 1rem;
  }
  .post-card__meta {
    margin: auto 0 0;
    font-size: 0.82rem;
    color: var(--ink-300);
    display: flex;
    gap: 0.4rem;
  }
</style>
