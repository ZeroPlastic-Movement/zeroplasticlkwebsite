---
import Figure from '../components/Figure.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, EXTERNAL } from '../consts';
import { breadcrumbSchema, organizationSchema } from '../lib/schema';

// A dedicated volunteer registration page is being built. Until it exists,
// enquiries route through /contact/ rather than back to the old WordPress
// front end, so nothing here depends on a page that is being retired.

const LOCAL = [
  { title: 'Clean-ups', body: 'Coastal, waterway and public-space clean-up campaigns.' },
  { title: 'Education', body: 'Delivering sessions in schools, universities and communities.' },
  { title: 'Awareness', body: 'Public campaigns that change everyday habits around plastic.' },
  { title: 'Advocacy', body: 'Supporting the case for EPR and single-use plastic reduction.' },
  { title: 'Research', body: 'Data collection, studies and evidence that strengthen campaigns.' },
  { title: 'Communication', body: 'Design, content, social media and press work.' },
  { title: 'Clubs', body: 'Running or joining a university, school or community club.' },
  { title: 'Campaigns', body: 'National campaigns and global days of action.' },
  { title: 'Events', body: 'Planning and delivering the logistics behind it all.' },
];

const INTERNATIONAL = [
  'Environmental campaigns',
  'Clean-ups',
  'Youth engagement',
  'Community work',
  'Sustainable tourism',
  'Impact Center activities',
  'Research',
  'Communications',
];
---

<BaseLayout
  title="Volunteer with ZeroPlastic"
  description="Volunteer with Sri Lanka's largest youth-led environmental movement. Clean-ups, education, advocacy and research, locally or while visiting Sri Lanka."
  image="/images/volunteers-local-800.jpg"
  schema={[
    organizationSchema(),
    breadcrumbSchema([
      { name: 'Home', url: '/' },
      { name: 'Volunteer', url: '/volunteers/' },
    ]),
  ]}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Get involved</p>
      <h1>Volunteers are the movement</h1>
      <p class="lede">
        Whether you live in Sri Lanka or are arriving on a flight next month, there is a way to
        contribute. Choose the path that fits.
      </p>
      <p class="hero-actions">
        <a class="button" href="#local">Volunteer in Sri Lanka</a>
        <a class="button button--ghost" href="#international">International volunteering</a>
      </p>
    </div>
  </section>

  <!-- ===================== LOCAL ===================== -->
  <section class="section" id="local">
    <div class="container">
      <div class="split">
        <div class="narrative">
          <p class="eyebrow">Pathway one</p>
          <h2 class="section__title">Volunteer in Sri Lanka</h2>
          <p>
            For people living in Sri Lanka who want to work on plastic pollution, through a
            university, school or community club, or independently.
          </p>
          <p>
            Not everyone can join a clean-up on a Saturday morning, and the movement does not
            depend on it. Design, writing, research and campaign planning all happen remotely,
            and all of it is needed.
          </p>
        </div>

        <Figure
          name="volunteers-local"
          alt="ZeroPlastic volunteers walking along a Sri Lankan beach carrying bags of collected waste."
          width={2000}
          height={1333}
          sizes="(max-width: 52rem) 100vw, 30rem"
        />
      </div>

      <h3 class="subhead">Where you can contribute</h3>
      <div class="tile-grid">
        {
          LOCAL.map((item) => (
            <div class="tile tile--compact">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>

      <p class="actions">
        <a class="button" href="/contact/">Contact us to volunteer</a>
        <a class="button button--ghost" href="/clubs/">Start a club instead</a>
      </p>
      <p class="registration-note">
        A dedicated volunteer registration page is opening soon. Until then, send us a message
        and the team will get you connected to a club or campaign.
      </p>
    </div>
  </section>

  <!-- ================== INTERNATIONAL ================== -->
  <section class="section section--dark" id="international">
    <div class="container">
      <p class="eyebrow eyebrow--light">Pathway two</p>
      <h2 class="section__title section__title--wide">
        Visit Sri Lanka. Volunteer for the environment. Experience the country differently.
      </h2>
      <p class="lede">
        Thousands of travellers come to Sri Lanka every year for the coast, the hills and the
        heritage. A smaller number leave having worked alongside the communities protecting them.
        This is for that smaller number.
      </p>

      <div class="split" style="margin-top:2.5rem">
        <div>
          <h3 class="subhead subhead--light">Where international volunteers contribute</h3>
          <ul class="ticks">
            {INTERNATIONAL.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <Figure
          name="traveller-craft"
          alt="International visitors making coconut-shell craft at a workbench during an Impact Center session."
          width={1200}
          height={900}
          sizes="(max-width: 52rem) 100vw, 28rem"
        />
      </div>

      <div class="enquiry">
        <h3>Arranging a placement</h3>
        <p>
          Placements are arranged individually, so that what you work on matches the time you
          have and the skills you bring. Tell us your dates and interests and we will explain what
          is running while you are here.
        </p>
        <p class="actions">
          <a class="button" href="/contact/">Contact us about volunteering</a>
          <a class="button button--outline" href="/sustainable-travel/">Sustainable travel</a>
        </p>
        <p class="note">
          We do not publish programme fees, visa guidance, accommodation or meal arrangements on
          this page, because those depend on the placement and on your own circumstances. Ask us
          and we will answer directly.
        </p>
      </div>
    </div>
  </section>

  <!-- ==================== ACADEMY ==================== -->
  <section class="section section--alt">
    <div class="container">
      <div class="split">
        <div class="narrative">
          <p class="eyebrow">Volunteers Academy</p>
          <h2 class="section__title">Developing the people behind the movement</h2>
          <p>
            Volunteers Academy is the youth and volunteer development arm connected to the
            ZeroPlastic ecosystem. It trains the volunteers who go on to lead campaigns, run clubs
            and organise events.
          </p>
          <p>
            It runs on its own platform, with its own programmes and intake.
          </p>
          <p>
            <a class="button" href={EXTERNAL.volunteersAcademy} rel="noopener noreferrer" target="_blank">
              Visit Volunteers Academy
            </a>
          </p>
        </div>

        <div class="tile">
          <h3>Questions first?</h3>
          <p>
            Email <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> or call
            <a href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a> and someone from the team
            will help.
          </p>
          <p class="tile__cta">
            <a class="ext-link" href="/contact/">Go to contact</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-actions,
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .narrative {
    max-width: 56ch;
  }
  .subhead {
    margin-top: 2.75rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-300);
  }
  .subhead--light {
    color: rgb(255 255 255 / 55%);
    margin-top: 0;
  }
  .registration-note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--ink-500);
    max-width: 58ch;
  }
  .tile--compact {
    padding: 1.15rem 1.25rem;
  }
  .tile--compact h3 {
    font-size: 1rem;
  }
  .tile--compact p {
    font-size: 0.89rem;
    margin: 0;
  }
  .enquiry {
    margin-top: 2.75rem;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    background: rgb(255 255 255 / 4%);
  }
  .enquiry h3 {
    margin-bottom: 0.5rem;
  }
  .enquiry p {
    color: rgb(255 255 255 / 70%);
    max-width: 62ch;
  }
  .note {
    font-size: 0.86rem;
    color: rgb(255 255 255 / 52%) !important;
    margin-bottom: 0;
  }
</style>
