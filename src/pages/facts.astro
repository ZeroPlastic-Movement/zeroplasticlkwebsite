<script>
  /**
   * Progressive enhancement for /facts.
   *
   * The HTML ships with every answer expanded and the share controls hidden,
   * so the page is complete before this runs and complete if it never runs.
   * This script collapses the answers, reveals the controls it can actually
   * deliver, and wires up deep linking.
   */
  (() => {
    const root = document.querySelector('.facts');
    if (!root) return;

    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-faq]'));
    if (!cards.length) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---------------- accordion ---------------- */

    const setOpen = (card: HTMLElement, open: boolean) => {
      const trigger = card.querySelector<HTMLButtonElement>('[data-faq-trigger]');
      const panel = card.querySelector<HTMLElement>('[data-faq-panel]');
      if (!trigger || !panel) return;
      trigger.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    const isOpen = (card: HTMLElement) =>
      card.querySelector('[data-faq-trigger]')?.getAttribute('aria-expanded') === 'true';

    // Collapse everything now that scripting is confirmed available.
    cards.forEach((card) => setOpen(card, false));

    cards.forEach((card) => {
      const trigger = card.querySelector<HTMLButtonElement>('[data-faq-trigger]');
      trigger?.addEventListener('click', () => {
        const next = !isOpen(card);
        setOpen(card, next);
        // Opening a question makes it addressable; closing gives the hash back.
        if (next) {
          history.pushState(null, '', `#${card.id}`);
        } else if (location.hash === `#${card.id}`) {
          history.pushState(null, '', location.pathname + location.search);
        }
      });
    });

    /* ---------------- deep linking ---------------- */

    let highlightTimer: number | undefined;

    const reveal = (id: string, smooth: boolean) => {
      const card = document.getElementById(id);
      if (!card || !card.matches('[data-faq]')) return false;

      // A filtered-out card cannot be scrolled to, so clear the filter first.
      if (card.hidden) {
        const input = root.querySelector<HTMLInputElement>('#faq-q');
        if (input) {
          input.value = '';
          applyFilter('');
        }
      }

      setOpen(card, true);
      // 'auto' resolves to the CSS scroll-behavior, which is smooth site-wide,
      // so an arrival jump would animate for almost a second and land focus
      // mid-flight. 'instant' is the only value that genuinely overrides it.
      card.scrollIntoView({
        behavior: smooth && !reduceMotion ? 'smooth' : 'instant',
        block: 'start',
      });

      // Focus the question itself, so a keyboard or screen-reader visitor
      // lands on the thing the link promised rather than the page top.
      //
      // Deferred by a task: the browser's own fragment navigation resets focus
      // to <body> shortly after the document loads, and a synchronous focus
      // here is silently undone a millisecond later.
      const trigger = card.querySelector<HTMLButtonElement>('[data-faq-trigger]');
      window.setTimeout(() => trigger?.focus({ preventScroll: true }), 0);

      card.classList.add('is-targeted');
      window.clearTimeout(highlightTimer);
      highlightTimer = window.setTimeout(() => card.classList.remove('is-targeted'), 2400);
      return true;
    };

    const syncToHash = (smooth: boolean) => {
      const id = decodeURIComponent(location.hash.replace(/^#/, ''));
      if (id) reveal(id, smooth);
    };

    // Back and forward across question links.
    window.addEventListener('popstate', () => syncToHash(true));
    // Same-page anchor clicks, including the floating list.
    window.addEventListener('hashchange', () => syncToHash(true));

    /* ---------------- share controls ---------------- */

    const absolute = (id: string) =>
      `${location.origin}${location.pathname.replace(/\/$/, '')}#${id}`;

    const canShare = typeof navigator.share === 'function';
    const copyLabel = root.querySelector<HTMLButtonElement>('[data-copy]')?.textContent ?? 'Copy link';
    const copiedLabel = 'Link copied';

    root.querySelectorAll<HTMLElement>('[data-share]').forEach((el) => {
      el.hidden = false;
    });

    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.copy!;
        const url = absolute(id);
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          // Clipboard API is unavailable or blocked (older Safari, insecure
          // context). Fall back to a selection the visitor can copy.
          const ta = document.createElement('textarea');
          ta.value = url;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand('copy');
          } catch {
            /* nothing more we can do; the URL is still in the address bar */
          }
          ta.remove();
        }
        btn.textContent = copiedLabel;
        btn.classList.add('is-done');
        window.setTimeout(() => {
          btn.textContent = copyLabel;
          btn.classList.remove('is-done');
        }, 1800);
      });
    });

    if (canShare) {
      root.querySelectorAll<HTMLButtonElement>('[data-native]').forEach((btn) => {
        btn.hidden = false;
        btn.addEventListener('click', async () => {
          const id = btn.dataset.native!;
          const card = document.getElementById(id);
          const title =
            card?.querySelector('.qcard__q')?.textContent?.trim() ?? document.title;
          try {
            await navigator.share({ title, url: absolute(id) });
          } catch {
            /* the visitor dismissed the sheet */
          }
        });
      });
    }

    /* ---------------- search ---------------- */

    const search = root.querySelector<HTMLElement>('[data-faq-search]');
    const empty = root.querySelector<HTMLElement>('[data-faq-empty]');

    function applyFilter(raw: string) {
      const q = raw.trim().toLowerCase();
      let shown = 0;
      cards.forEach((card) => {
        const hay = card.dataset.search ?? '';
        const match = !q || hay.includes(q);
        card.hidden = !match;
        if (match) shown++;
      });
      if (empty) empty.hidden = shown !== 0;
    }

    if (search) {
      search.hidden = false;
      const input = search.querySelector<HTMLInputElement>('#faq-q');
      input?.addEventListener('input', () => applyFilter(input.value));
      // Escape clears, which is what people expect of a search field.
      input?.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && input.value) {
          input.value = '';
          applyFilter('');
        }
      });
    }

    /* ---------------- floating question list ---------------- */

    const jump = root.querySelector<HTMLElement>('[data-qjump]');
    if (jump) {
      jump.hidden = false;
      const openBtn = jump.querySelector<HTMLButtonElement>('[data-qjump-open]');
      const closeBtn = jump.querySelector<HTMLButtonElement>('[data-qjump-close]');
      const panel = jump.querySelector<HTMLElement>('#qjump-panel');

      const toggle = (open: boolean) => {
        if (!panel || !openBtn) return;
        panel.hidden = !open;
        openBtn.setAttribute('aria-expanded', String(open));
        if (open) panel.querySelector<HTMLAnchorElement>('a')?.focus();
        else openBtn.focus();
      };

      openBtn?.addEventListener('click', () => toggle(panel ? panel.hidden === true : true));
      closeBtn?.addEventListener('click', () => toggle(false));
      panel?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) toggle(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && panel && !panel.hidden) toggle(false);
      });
      document.addEventListener('click', (e) => {
        if (panel && !panel.hidden && !jump.contains(e.target as Node)) toggle(false);
      });
    }

    /* ---------------- first paint ---------------- */

    // A visitor arriving on /facts#recycling should land on that answer, open.
    // Jump without animation on load: the smooth version fights the browser's
    // own restoration and lands short. Waiting for load lets the browser finish
    // its native fragment handling first, so ours is the one that sticks.
    if (document.readyState === 'complete') {
      syncToHash(false);
    } else {
      window.addEventListener('load', () => syncToHash(false), { once: true });
    }
  })();
</script>
