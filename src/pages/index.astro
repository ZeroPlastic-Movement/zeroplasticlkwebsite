---
import Figure from '../components/Figure.astro';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  ADVOCACY,
  ALERT_URL,
  ECOSYSTEM,
  EXTERNAL,
  HERO,
  MOVEMENT,
  PILLARS,
  POSITIONING,
  SITE,
  STATS,
  TRAVEL,
} from '../consts';
import { organizationSchema, websiteSchema } from '../lib/schema';
import { getRecentPosts } from '../lib/wp';

const posts = await getRecentPosts(3);

const srcset = (ext: string) =>
  HERO.widths.map((w) => `${HERO.base}-${w}.${ext} ${w}w`).join(', ');

const [impactCenter, travelPledge] = TRAVEL;
---

<BaseLayout
  title="ZeroPlastic Movement | Ending plastic pollution in Sri Lanka"
  description={SITE.description}
  image="/images/og-home.jpg"
  schema={[organizationSchema(), websiteSchema()]}
>
  <!-- ============================= HERO ============================= -->
  <section class="hero">
    <picture class="hero__media">
      <source type="image/avif" srcset={srcset('avif')} sizes="100vw" />
      <source type="image/webp" srcset={srcset('webp')} sizes="100vw" />
      <img
        src={`${HERO.base}-1280.jpg`}
        width={HERO.width}
        height={HERO.height}
        alt={HERO.alt}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
    </picture>

    <div class="container hero__inner">
      <p class="hero__eyebrow">ZeroPlastic Movement · Sri Lanka</p>
      <h1 class="hero__title">{POSITIONING}</h1>
      <p class="hero__lede">
        One of Sri Lanka's largest youth environmental movements — cutting plastic at the source
        through education, advocacy, clean-ups and the alternatives that replace plastic for good.
      </p>

      <div class="hero__actions">
        <a class="button button--lg" href="/volunteers/">Join the Movement</a>
        <a class="button button--lg button--outline" href="#impact">Explore Our Impact</a>
      </div>
    </div>
  </section>

  <!-- ========================= IMPACT NUMBERS ======================== -->
  <section class="section section--dark" id="impact">
    <div class="container">
      <p class="eyebrow eyebrow--light">Our impact</p>
      <h2 class="section__title section__title--wide">A movement measured in people, not press releases</h2>

      <dl class="impact">
        {
          STATS.map((stat) => (
            <div class="impact__item">
              <dt class="impact__value">{stat.value}</dt>
              <dd class="impact__label">
                {stat.label}
                <span class="impact__detail">{stat.detail}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ========================== WHO WE ARE ========================== -->
  <section class="section">
    <div class="container who">
      <div>
        <p class="eyebrow">Who we are</p>
        <h2 class="section__title">A volunteer movement for a plastic-free Sri Lanka</h2>
      </div>
      <div>
        <p class="lede">
          ZeroPlastic is a Sri Lankan environmental movement built on volunteers. We work to change
          everyday behaviour around plastic, push for the policy that makes that change stick, and
          build the market for local alternatives.
        </p>
        <p>
          Our clubs operate across universities, schools and communities, giving the movement a
          permanent presence in Sri Lankan education rather than a series of one-off campaigns.
        </p>
        <p>
          <a class="button button--ghost" href="/about/">More about the movement</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ========================== WHAT WE DO ========================== -->
  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2 class="section__title">Four ways we cut plastic at the source</h2>

      <ol class="pillars">
        {
          PILLARS.map((pillar, index) => (
            <li class="pillar">
              <span class="pillar__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <p class="pillar__stage">{pillar.stage}</p>
              <h3>{pillar.title}</h3>
              <p class="pillar__body">{pillar.body}</p>
            </li>
          ))
        }
      </ol>

      <p style="margin-top:2rem">
        <a class="button button--ghost" href="/our-work/">See how our work fits together</a>
      </p>
    </div>
  </section>

  <!-- ==================== ADVOCACY & SYSTEM CHANGE =================== -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <p class="eyebrow">Advocacy &amp; system change</p>
          <h2 class="section__title">Clean-ups treat the symptom. Policy treats the cause.</h2>
          <p class="lede">
            ZeroPlastic is not only a clean-up organisation. We work on behavioural change, policy
            advocacy and systemic solutions — because the plastic on a beach was a decision made
            somewhere upstream.
          </p>
          <p>
            <a class="button" href="/advocacy/">Our advocacy work</a>
          </p>
        </div>

        <Figure
          name="advocacy-sculpture"
          alt="A life-size elephant sculpture constructed entirely from recovered plastic waste."
          width={1367}
          height={1025}
          sizes="(max-width: 52rem) 100vw, 32rem"
        />
      </div>

      <div class="tile-grid">
        {
          ADVOCACY.map((item) => (
            <div class="tile">
              <p class="tile__meta">{item.tag}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================= OUR MOVEMENT ========================== -->
  <section class="section section--dark">
    <div class="container">
      <p class="eyebrow eyebrow--light">Our movement</p>
      <h2 class="section__title section__title--wide">National campaigns, global days of action</h2>

      <div class="tile-grid">
        {
          MOVEMENT.map((item) => (
            <div class="tile">
              <p class="tile__meta">{item.meta}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              {'href' in item && item.href && (
                <p class="tile__cta">
                  <a class="ext-link" href={item.href}>Explore ZeroPlastic Clubs</a>
                </p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= SUSTAINABLE TRAVEL ====================== -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <div>
          <p class="eyebrow">Sustainable travel</p>
          <h2 class="section__title">Travel that leaves less behind</h2>
        </div>
        <a class="button button--ghost" href="/sustainable-travel/">All travel initiatives</a>
      </div>

      <div class="tile-grid tile-grid--2">
        {
          [impactCenter, travelPledge].map((item) => (
            <article class="travel-card">
              <Figure
                name={item.image}
                alt={item.alt}
                width={1200}
                height={item.image === 'impact-center' ? 675 : 900}
                sizes="(max-width: 52rem) 100vw, 30rem"
              />
              <div class="travel-card__body">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                <p class="tile__cta">
                  <a class="ext-link" href={item.href} rel="noopener noreferrer" target="_blank">
                    {item.cta}
                  </a>
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =========================== VOLUNTEER =========================== -->
  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">Volunteer</p>
      <h2 class="section__title">Two ways to give your time</h2>

      <div class="tile-grid tile-grid--2">
        <div class="tile">
          <h3>Volunteer in Sri Lanka</h3>
          <p>
            Join campaigns, clean-ups, awareness and education work, advocacy, research and
            communications — through a university, school or community club, or on your own.
          </p>
          <p class="tile__cta">
            <a class="button" href="/volunteers/">Volunteer locally</a>
          </p>
        </div>

        <div class="tile">
          <h3>International volunteering</h3>
          <p>
            Visit Sri Lanka, volunteer for the environment, and experience the country differently —
            through clean-ups, community engagement, education and Impact Center activities.
          </p>
          <p class="tile__cta">
            <a class="button button--ghost" href="/volunteers/#international">
              Volunteer from abroad
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= LATEST STORIES ======================== -->
  <section class="section">
    <div class="container">
      <div class="section__head">
        <div>
          <p class="eyebrow">Latest stories</p>
          <h2 class="section__title">What our clubs did this month</h2>
        </div>
        <a class="button button--ghost" href="/blog/">All stories</a>
      </div>

      <div class="grid grid--3" style="margin-top:2.25rem">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <!-- ===================== INITIATIVES / ECOSYSTEM =================== -->
  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">Initiatives</p>
      <h2 class="section__title section__title--wide">The wider ZeroPlastic ecosystem</h2>
      <p class="lede">
        Each of these runs on its own dedicated platform. Here is what they do and where to go next.
      </p>

      <div class="tile-grid">
        {
          ECOSYSTEM.map((item) => (
            <div class="tile">
              <h3>{item.title}</h3>
              <p class="tile__meta" style="color:var(--ink-300);text-transform:none;letter-spacing:0;font-weight:600">
                {item.tagline}
              </p>
              <p>{item.body}</p>
              <p class="tile__cta">
                <a class="ext-link" href={item.href} rel="noopener noreferrer" target="_blank">
                  {item.cta}
                </a>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ====================== REPORT PLASTIC POLLUTION ================= -->
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Seen plastic pollution?</h2>
          <p>
            Submit the violation and we notify the relevant authorities, so environmental action
            happens faster.
          </p>
        </div>
        <a class="button button--lg" href={ALERT_URL} rel="noopener noreferrer" target="_blank">
          Report Plastic Pollution
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------- hero ------------------------------- */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: min(80vh, 680px);
    padding-block: clamp(3rem, 10vw, 5.5rem);
    background: var(--ink-900);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 60%;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(105deg, rgb(10 22 12 / 88%) 0%, rgb(10 22 12 / 72%) 38%, rgb(10 22 12 / 24%) 72%, rgb(10 22 12 / 38%) 100%),
      linear-gradient(to top, rgb(10 22 12 / 62%) 0%, transparent 45%);
  }
  @media (max-width: 56rem) {
    .hero::after {
      background: linear-gradient(to bottom, rgb(10 22 12 / 82%) 0%, rgb(10 22 12 / 68%) 45%, rgb(10 22 12 / 78%) 100%);
    }
  }
  .hero__inner {
    position: relative;
    max-width: 64rem;
  }
  .hero__eyebrow {
    color: var(--green-400);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.75rem;
    font-weight: 700;
    margin: 0 0 1rem;
  }
  .hero__title {
    color: #fff;
    font-size: clamp(2.1rem, 1.1rem + 3.8vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    max-width: 18ch;
    margin: 0 0 1.1rem;
  }
  .hero__lede {
    color: rgb(255 255 255 / 84%);
    font-size: clamp(1rem, 0.94rem + 0.4vw, 1.18rem);
    max-width: 54ch;
    margin: 0 0 2rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  /* ------------------------------ impact ------------------------------ */
  .impact {
    display: grid;
    gap: 2rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    margin: 2.5rem 0 0;
  }
  .impact__value {
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3rem);
    font-weight: 750;
    color: var(--green-400);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .impact__label {
    color: #fff;
    font-weight: 650;
    margin: 0;
  }
  .impact__detail {
    display: block;
    color: rgb(255 255 255 / 58%);
    font-weight: 400;
    font-size: 0.86rem;
    margin-top: 0.3rem;
  }

  /* ----------------------------- who we are --------------------------- */
  .who {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: start;
  }

  /* ------------------------------ pillars ----------------------------- */
  .pillars {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .pillar {
    background: var(--surface);
    padding: 1.6rem 1.4rem;
  }
  .pillar__index {
    font-size: 0.72rem;
    font-weight: 750;
    color: var(--green-500);
    letter-spacing: 0.12em;
  }
  .pillar__stage {
    margin: 0.7rem 0 0.15rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-300);
    font-weight: 700;
  }
  .pillar h3 {
    font-size: 1.08rem;
    margin-bottom: 0.5rem;
  }
  .pillar__body {
    color: var(--ink-500);
    font-size: 0.92rem;
    margin: 0;
  }

  /* --------------------------- travel cards --------------------------- */
  .travel-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .travel-card :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .travel-card__body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .travel-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .travel-card p {
    color: var(--ink-500);
    font-size: 0.93rem;
  }
</style>
