---
/**
 * /one-traveller-one-kilogram/: tourism partnership landing page.
 *
 * The audience is travel businesses (operators, DMCs, hotels), not travellers,
 * so this is a B2B page and is not a Google Ads Final URL.
 *
 * Things worth knowing before editing:
 *
 *   1. Copy lives in src/data/one-traveller-one-kilogram.ts, tagged by where
 *      each claim came from. The FAQ JSON-LD is generated from the same array
 *      the page renders.
 *
 *   2. The programme has not started. Every sentence must keep a commitment
 *      (created by a qualifying visit) apart from a verified removal (only
 *      after a cleanup). It is also not carbon offsetting.
 *
 *   3. There is deliberately no visitor-counting, referral or tracking
 *      feature here. The slider is an illustration of arithmetic and says so.
 *
 *   4. Analytics follow the self-drive page: the existing GTM container,
 *      data-ev attributes and one delegated listener. No AW- id and no
 *      conversion is configured from page code. The event names below are new
 *      and do nothing until GTM has a trigger for them.
 *
 *   5. The form posts to /api/partner-enquiry (functions/api/), which holds
 *      the Make webhook secret. Nothing secret is in this file.
 *
 *   6. No photographs have been supplied. The artwork is CSS gradient, marked
 *      aria-hidden because it carries no information.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { breadcrumbSchema, organizationSchema } from '../lib/schema';
import {
  APPLY,
  BENEFITS,
  CENTER,
  EVIDENCE,
  EXAMPLES,
  FAQS,
  HERO,
  ILLUSTRATION,
  LINKS,
  ORGANISATION_TYPES,
  PAGE,
  PARTNER_CONTACT,
  PREVENTION,
  PROGRAMME,
  STEPS,
  TRAVELLER_VOLUMES,
  TRUST,
} from '../data/one-traveller-one-kilogram';

const BASE = (Astro.site?.href ?? SITE.url).replace(/\/$/, '');
const pageUrl = `${BASE}${PAGE.path}`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/**
 * The page and the programme it describes. Deliberately no `offers`, no
 * `aggregateRating` and no `award`: there is nothing published to support them,
 * and price 0 would model a partnership as a product.
 */
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: PAGE.title,
  description: PAGE.description,
  inLanguage: SITE.lang,
  isPartOf: { '@id': `${BASE}/#website` },
  about: { '@id': `${pageUrl}#programme` },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: `${BASE}${PAGE.ogImage}`,
    width: PAGE.ogImageWidth,
    height: PAGE.ogImageHeight,
  },
};

const programmeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#programme`,
  name: 'One Traveller, One Kilogram',
  serviceType: 'Tourism partnership for plastic waste removal',
  description:
    'A ZeroPlastic Movement partnership with travel businesses. Each qualifying traveller who visits the ZeroPlastic Impact Center in Sigiriya through a registered partner creates a commitment to remove 1 kg of plastic waste from Sri Lanka\'s environment, primarily beaches. Programme begins 1 January 2027. Every additional 300 qualifying travellers from a registered partner triggers another dedicated cleanup removing at least 300 kg of plastic.',
  provider: { '@id': `${BASE}/#organization` },
  areaServed: { '@type': 'Country', name: 'Sri Lanka' },
  audience: { '@type': 'BusinessAudience', audienceType: 'Tour operators, destination management companies and hotels' },
  url: pageUrl,
};

const crumbs = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Sustainable travel', url: LINKS.sustainableTravel },
  { name: 'One Traveller, One Kilogram', url: PAGE.path },
]);

const waHref = PARTNER_CONTACT.whatsappHref;
const mailHref = `mailto:${PARTNER_CONTACT.email}?subject=${encodeURIComponent(PARTNER_CONTACT.mailSubject)}`;
---

<BaseLayout
  title={PAGE.title}
  description={PAGE.description}
  image={PAGE.ogImage}
  schema={[organizationSchema(), webPageSchema, programmeSchema, faqSchema, crumbs]}
>
  <!-- Same GTM container as the other landing pages. Nothing is configured
       here: conversions belong in GTM, not in page code. -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=GTM-N85V5638"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'GTM-N85V5638');
  </script>

  <div class="otk">
    <!-- ============================= HERO ============================ -->
    <section class="otk-hero" aria-labelledby="otk-h1">
      <div class="container otk-hero__grid">
        <div class="otk-hero__copy">
          <p class="otk-eyebrow">{HERO.eyebrow}</p>
          <h1 id="otk-h1" class="otk-h1">
            {HERO.h1Lines.map((line, i) => (<span class:list={['otk-h1__line', { 'otk-h1__line--accent': i === 1 }]}>{line}</span>))}
          </h1>
          <p class="otk-hero__sub">{HERO.sub}</p>
          <div class="otk-actions">
            <a class="button button--lg otk-btn" href="#apply" data-ev="one_kg_apply_click">Apply as a travel partner</a>
            <a class="button button--lg button--outline" href={waHref} target="_blank" rel="noopener noreferrer" data-ev="one_kg_whatsapp_click">WhatsApp us</a>
          </div>
          <ul class="otk-facts">
            {HERO.facts.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div class="otk-hero__art" aria-hidden="true">
          <div class="otk-art">
            <span class="otk-art__ring otk-art__ring--1"></span>
            <span class="otk-art__ring otk-art__ring--2"></span>
            <span class="otk-art__ring otk-art__ring--3"></span>
            <div class="otk-medallion">
              <strong>{HERO.medallion.value}</strong>
              <span>{HERO.medallion.label}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================ TRUST ============================ -->
    <section class="otk-trust" aria-label="About the movement">
      <div class="container otk-trust__grid">
        <p class="otk-trust__lead">{TRUST.lead}</p>
        <ul class="otk-trust__stats">
          {TRUST.items.map((s) => (
            <li><strong>{s.value}</strong><span>{s.label}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- =========================== BENEFITS ========================== -->
    <section class="section" aria-labelledby="otk-benefits">
      <div class="container">
        <div class="otk-head">
          <p class="eyebrow">{BENEFITS.eyebrow}</p>
          <h2 id="otk-benefits" class="otk-title">{BENEFITS.title}</h2>
          <p class="lede">{BENEFITS.intro}</p>
        </div>
        <ul class="otk-cards">
          {BENEFITS.items.map((b, i) => (
            <li class="otk-card">
              <span class={`otk-card__mark otk-card__mark--${i + 1}`} aria-hidden="true"></span>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ========================== HOW IT WORKS ======================= -->
    <section class="section section--alt" aria-labelledby="otk-how">
      <div class="container">
        <div class="otk-head">
          <p class="eyebrow">{STEPS.eyebrow}</p>
          <h2 id="otk-how" class="otk-title">{STEPS.title}</h2>
          <p class="lede">{STEPS.intro}</p>
        </div>
        <ol class="otk-steps">
          {STEPS.items.map((s, i) => (
            <li class="otk-step">
              <span class="otk-step__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>

        <div class="otk-examples">
          <h3>{EXAMPLES.title}</h3>
          <p>{EXAMPLES.intro}</p>
          <table>
            <caption class="visually-hidden">Qualifying travellers, dedicated cleanups and cumulative removal commitment</caption>
            <thead>
              <tr>
                <th scope="col">Qualifying travellers</th>
                <th scope="col">Dedicated cleanups</th>
                <th scope="col">Cumulative removal, once each cleanup is completed</th>
              </tr>
            </thead>
            <tbody>
              {EXAMPLES.rows.map((r) => (
                <tr>
                  <th scope="row">{r.travellers}</th>
                  <td>{r.cleanups}</td>
                  <td>at least {r.kg} kg</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="otk-examples__note">{EXAMPLES.note}</p>
        </div>

        <div class="otk-demo" data-demo data-milestone={PROGRAMME.milestoneTravellers}>
          <div class="otk-demo__copy">
            <p class="eyebrow">{ILLUSTRATION.eyebrow}</p>
            <h3>{ILLUSTRATION.title}</h3>
            <p>{ILLUSTRATION.body}</p>
          </div>
          <div class="otk-demo__card">
            <label class="otk-demo__label" for="otk-range">
              Illustrative qualifying travellers for one partner
              <output id="otk-travellers" for="otk-range">{ILLUSTRATION.start}</output>
            </label>
            <input id="otk-range" type="range" min="0" max={ILLUSTRATION.max} step={ILLUSTRATION.step} value={ILLUSTRATION.start} />
            <div class="otk-demo__bar" aria-hidden="true"><span data-bar></span></div>
            <p class="otk-demo__status" role="status" data-status></p>
            <dl class="otk-demo__stats">
              <div><dt>Cumulative commitment</dt><dd data-commitment></dd></div>
              <div><dt>Dedicated cleanups triggered</dt><dd data-cleanups></dd></div>
              <div><dt>Pending toward the next cleanup</dt><dd data-progress></dd></div>
              <div><dt>Completed, verified removal</dt><dd class="otk-demo__none">None shown here</dd></div>
            </dl>
            <p class="otk-demo__note">{ILLUSTRATION.caption}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================== IMPACT CENTER ===================== -->
    <section class="section" aria-labelledby="otk-center">
      <div class="container otk-split">
        <div class="otk-photo" aria-hidden="true"><span></span></div>
        <div>
          <p class="eyebrow">{CENTER.eyebrow}</p>
          <h2 id="otk-center" class="otk-title otk-title--left">{CENTER.title}</h2>
          <p class="lede">{CENTER.body}</p>
          <ul class="ticks otk-ticks">
            {CENTER.points.map((p) => <li>{p}</li>)}
          </ul>
          <p class="otk-links">
            <a class="button" href={LINKS.impactCenter} target="_blank" rel="noopener noreferrer" data-ev="one_kg_impact_center_click">Explore the Impact Center</a>
            <a class="otk-textlink" href={LINKS.sustainableTravel}>More on sustainable travel with ZeroPlastic</a>
          </p>
          <p class="note otk-note">{CENTER.note}</p>
        </div>
      </div>
    </section>

    <!-- ============================ EVIDENCE ========================= -->
    <section class="otk-dark" aria-labelledby="otk-evidence">
      <div class="container">
        <div class="otk-head otk-head--light">
          <p class="otk-eyebrow">{EVIDENCE.eyebrow}</p>
          <h2 id="otk-evidence" class="otk-title">{EVIDENCE.title}</h2>
          <p class="otk-lede">{EVIDENCE.intro}</p>
        </div>
        <div class="otk-evidence">
          <div>
            <h3 class="otk-evidence__h">What partners receive</h3>
            <ul class="otk-receive">
              {EVIDENCE.receive.map((r) => (
                <li><strong>{r.title}</strong><span>{r.body}</span></li>
              ))}
            </ul>
          </div>
          <div class="otk-claims">
            <div>
              <h3 class="otk-evidence__h">You can say</h3>
              <ul>{EVIDENCE.claims.can.map((c) => <li>{c}</li>)}</ul>
            </div>
            <div>
              <h3 class="otk-evidence__h">Please do not say</h3>
              <ul>{EVIDENCE.claims.cannot.map((c) => <li>{c}</li>)}</ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =========================== PREVENTION ======================== -->
    <section class="section section--alt" aria-labelledby="otk-prevent">
      <div class="container">
        <div class="otk-head">
          <p class="eyebrow">{PREVENTION.eyebrow}</p>
          <h2 id="otk-prevent" class="otk-title">{PREVENTION.title}</h2>
          <p class="lede">{PREVENTION.intro}</p>
        </div>
        <ul class="otk-cards otk-cards--three">
          {PREVENTION.items.map((p) => (
            <li class="otk-card"><h3>{p.title}</h3><p>{p.body}</p></li>
          ))}
        </ul>
        <p class="otk-center-link">
          <a class="otk-textlink" href={PREVENTION.article.href}>{PREVENTION.article.label}</a>
        </p>
      </div>
    </section>

    <!-- ============================== FAQ ============================ -->
    <section class="section" id="faq" aria-labelledby="otk-faq">
      <div class="container otk-faq">
        <div>
          <p class="eyebrow">Questions from travel partners</p>
          <h2 id="otk-faq" class="otk-title otk-title--left">The details, made clear</h2>
          <p class="lede">We want partners to describe the programme accurately and never overstate it.</p>
        </div>
        <div class="otk-faq__list">
          {FAQS.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================== APPLY ========================== -->
    <section class="otk-apply" id="apply" aria-labelledby="otk-apply-h">
      <div class="container otk-apply__grid">
        <div>
          <p class="eyebrow">{APPLY.eyebrow}</p>
          <h2 id="otk-apply-h" class="otk-title otk-title--left">{APPLY.title}</h2>
          <p class="lede">{APPLY.intro}</p>
          <p class="otk-callout">{APPLY.callout}</p>
          <ul class="otk-contacts">
            <li>
              <span>Partnership email</span>
              <a href={mailHref} data-ev="one_kg_email_click">{PARTNER_CONTACT.email}</a>
            </li>
            <li>
              <span>WhatsApp</span>
              <a href={waHref} target="_blank" rel="noopener noreferrer" data-ev="one_kg_whatsapp_click">{PARTNER_CONTACT.whatsappDisplay}</a>
            </li>
          </ul>
          <p class="otk-center-link otk-center-link--left">
            <a class="button button--lg otk-btn otk-btn--wa" href={waHref} target="_blank" rel="noopener noreferrer" data-ev="one_kg_whatsapp_click">Ask a question on WhatsApp</a>
          </p>
        </div>

        <div class="otk-formcard">
          <h3>{APPLY.formTitle}</h3>
          <p class="otk-formcard__sub">Fields marked with an asterisk are required.</p>

          <form id="otk-form" novalidate data-wa={waHref}>
            <div class="otk-grid">
              <div class="otk-field otk-field--full">
                <label for="company">Company or organisation name *</label>
                <input id="company" name="company" required maxlength="120" autocomplete="organization" />
                <p class="otk-err" data-err-for="company" hidden></p>
              </div>
              <div class="otk-field">
                <label for="organisation_type">Type of organisation *</label>
                <select id="organisation_type" name="organisation_type" required>
                  <option value="">Select one</option>
                  {ORGANISATION_TYPES.map((t) => <option value={t}>{t}</option>)}
                </select>
                <p class="otk-err" data-err-for="organisation_type" hidden></p>
              </div>
              <div class="otk-field">
                <label for="country">Country *</label>
                <input id="country" name="country" required maxlength="80" autocomplete="country-name" />
                <p class="otk-err" data-err-for="country" hidden></p>
              </div>
              <div class="otk-field">
                <label for="contact_name">Contact name *</label>
                <input id="contact_name" name="contact_name" required maxlength="100" autocomplete="name" />
                <p class="otk-err" data-err-for="contact_name" hidden></p>
              </div>
              <div class="otk-field">
                <label for="email">Business email *</label>
                <input id="email" name="email" type="email" required maxlength="160" autocomplete="email" inputmode="email" />
                <p class="otk-err" data-err-for="email" hidden></p>
              </div>
              <div class="otk-field">
                <label for="whatsapp">WhatsApp number *</label>
                <input id="whatsapp" name="whatsapp" type="tel" required maxlength="40" autocomplete="tel" inputmode="tel" aria-describedby="whatsapp-hint" />
                <p class="otk-hint" id="whatsapp-hint">Include the country code.</p>
                <p class="otk-err" data-err-for="whatsapp" hidden></p>
              </div>
              <div class="otk-field">
                <label for="website">Company website</label>
                <input id="website" name="website" maxlength="200" autocomplete="url" inputmode="url" />
                <p class="otk-err" data-err-for="website" hidden></p>
              </div>
              <div class="otk-field otk-field--full">
                <label for="estimated_traveller_volume">Estimated travellers to Sri Lanka each year *</label>
                <select id="estimated_traveller_volume" name="estimated_traveller_volume" required>
                  <option value="">Select an approximate band</option>
                  {TRAVELLER_VOLUMES.map((v) => <option value={v}>{v}</option>)}
                </select>
                <p class="otk-err" data-err-for="estimated_traveller_volume" hidden></p>
              </div>
              <div class="otk-field otk-field--full">
                <label for="message">Anything you would like us to know</label>
                <textarea id="message" name="message" rows="4" maxlength="1500"></textarea>
              </div>

              <!-- Honeypot. Off-screen rather than display:none, which many
                   bots skip. Real visitors and assistive tech never reach it. -->
              <div class="otk-trap" aria-hidden="true">
                <label for="hp_check">Leave this field empty</label>
                <input id="hp_check" name="hp_check" type="text" tabindex="-1" autocomplete="off" autocorrect="off" spellcheck="false" />
              </div>
            </div>

            <div class="otk-consent">
              <input id="consent_contact" name="consent_contact" type="checkbox" required />
              <label for="consent_contact">
                {APPLY.consent} <a href={LINKS.privacy}>Privacy policy</a>. *
              </label>
              <p class="otk-err" data-err-for="consent_contact" hidden></p>
            </div>

            <div class="otk-alert" role="alert" tabindex="-1" data-alert hidden></div>

            <button class="button button--lg otk-btn otk-submit" type="submit" data-submit>Send partnership enquiry</button>
          </form>

          <div class="otk-sent" data-sent tabindex="-1" hidden>
            <h3>Thank you. Your enquiry has been received.</h3>
            <p>Our team reviews every application personally and will reply to the email address you gave. Your reference is <strong data-ref></strong>.</p>
            <p>Receiving this enquiry does not mean a partner place has been confirmed.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Palette is local to this page. global.css is shared by every route, so
     nothing here changes a site-wide token. */
  .otk {
    --deep: #083c38;
    --deeper: #062c2b;
    --forest: #0f6b5d;
    --mint: #b5edd4;
    --orange: #ff9b63;
    --orange-strong: #f4743e;
    --ink: #153731;
    --muted: #4f625a;
    color: var(--ink);
  }

  .otk :global(h1),
  .otk :global(h2),
  .otk :global(h3) {
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  /* The shared .eyebrow green is 3.3:1 on white, short of AA for small text.
     Darkened here only, as CLAUDE.md asks for page-level contrast fixes. */
  .otk :global(.eyebrow) {
    color: #3f6b12;
  }

  .otk-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.78rem;
    font-weight: 750;
    color: var(--mint);
    margin: 0 0 1rem;
  }

  /* ----- hero ----- */
  .otk-hero {
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(ellipse at 78% 35%, #1f6f5e 0, transparent 46%),
      linear-gradient(150deg, #104238, var(--deeper) 68%);
  }
  .otk-hero__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    padding-block: clamp(2.75rem, 7vw, 5.5rem);
  }
  .otk-h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.4rem, 1.4rem + 4.6vw, 4.6rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    color: #fff;
  }
  .otk-h1__line {
    display: block;
  }
  .otk-h1__line--accent {
    color: var(--orange);
  }
  .otk-hero__sub {
    max-width: 38rem;
    font-size: clamp(1.02rem, 0.95rem + 0.4vw, 1.2rem);
    color: rgb(255 255 255 / 86%);
    margin: 0 0 1.75rem;
  }
  .otk-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  /* Orange on deep green: the one warm note on the page, kept for the
     primary action. Dark text keeps the label well past AA. */
  .otk-btn {
    background: var(--orange);
    color: var(--deeper);
    font-weight: 750;
  }
  .otk-btn:hover {
    background: #ffb184;
    color: var(--deeper);
  }
  .otk-btn--wa {
    background: var(--deep);
    color: #fff;
  }
  .otk-btn--wa:hover {
    background: var(--forest);
    color: #fff;
  }
  .otk-hero .button,
  .otk-apply .button--lg {
    min-height: 2.75rem;
  }
  .otk-facts {
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--mint);
  }
  .otk-facts li::before {
    content: '';
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.55rem;
    border-radius: 50%;
    background: var(--orange);
  }

  .otk-art {
    position: relative;
    aspect-ratio: 1;
    max-width: 26rem;
    margin-inline: auto;
    display: grid;
    place-items: center;
  }
  .otk-art__ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgb(181 237 212 / 28%);
    inset: 0;
  }
  .otk-art__ring--2 {
    inset: 12%;
  }
  .otk-art__ring--3 {
    inset: 26%;
    background: radial-gradient(circle, rgb(31 111 94 / 55%), transparent 70%);
  }
  .otk-medallion {
    position: relative;
    display: grid;
    place-content: center;
    text-align: center;
    width: 52%;
    aspect-ratio: 1;
    border-radius: 50%;
