<script>
  /**
   * Analytics, the illustration and the form.
   *
   * The tracker mirrors the helper in self-drive-sri-lanka.astro and the
   * volunteer landing page: gtag when present, dataLayer otherwise, and never
   * throws, because a blocked analytics script must not break the page. No
   * name, email, number or free text is ever placed in an event.
   */
  (() => {
    const root = document.querySelector('.otk');
    if (!root) return;

    function track(name: string, params?: Record<string, unknown>) {
      try {
        const w = window as unknown as {
          gtag?: (...a: unknown[]) => void;
          dataLayer?: Record<string, unknown>[];
        };
        if (typeof w.gtag === 'function') w.gtag('event', name, params || {});
        else if (w.dataLayer) w.dataLayer.push(Object.assign({ event: name }, params || {}));
      } catch {
        /* analytics must never break the page */
      }
    }

    track('one_kg_page_view', { page_location: location.pathname });

    root.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement)?.closest?.('[data-ev]') as HTMLElement | null;
      const name = el?.dataset.ev;
      if (name) track(name, { link_text: (el?.textContent || '').trim().slice(0, 80) });
    });

    /* ---------------- illustration ---------------- */
    const demo = root.querySelector<HTMLElement>('[data-demo]');
    if (demo) {
      const range = demo.querySelector<HTMLInputElement>('#otk-range')!;
      const out = demo.querySelector<HTMLOutputElement>('#otk-travellers')!;
      const bar = demo.querySelector<HTMLElement>('[data-bar]')!;
      const status = demo.querySelector<HTMLElement>('[data-status]')!;
      const commitment = demo.querySelector<HTMLElement>('[data-commitment]')!;
      const progress = demo.querySelector<HTMLElement>('[data-progress]')!;
      const cleanups = demo.querySelector<HTMLElement>('[data-cleanups]')!;
      const milestone = Number(demo.dataset.milestone) || 300;

      // Each block of `milestone` travellers is one cleanup, so the kilograms
      // pending toward the next one are only the remainder. A traveller is in
      // exactly one block, which is what stops anything being counted twice.
      const render = () => {
        const n = Number(range.value);
        const done = Math.floor(n / milestone);
        const rem = n % milestone;
        out.textContent = n.toLocaleString('en');
        bar.style.width = `${((rem === 0 && n > 0 ? milestone : rem) / milestone) * 100}%`;
        commitment.textContent = `${n.toLocaleString('en')} kg`;
        cleanups.textContent = String(done);
        progress.textContent = `${rem} of ${milestone}`;
        const noun = done === 1 ? 'cleanup' : 'cleanups';
        status.textContent =
          n === 0
            ? `No qualifying travellers yet. The first dedicated cleanup follows the first ${milestone}.`
            : done === 0
              ? `${milestone - n} more qualifying travellers until the first dedicated cleanup of at least ${milestone} kg. These ${n} kg are a pending commitment, not removed plastic.`
              : `${done} dedicated ${noun} triggered: at least ${(done * milestone).toLocaleString('en')} kg to be removed, and reported once each cleanup is completed.${rem ? ` The other ${rem} kg stays pending until the next ${milestone}.` : ''}`;
      };
      range.addEventListener('input', render);
      render();
    }

    /* ---------------- form ---------------- */
    const form = root.querySelector<HTMLFormElement>('#otk-form');
    if (!form) return;

    // One reference per page load. Reusing it across a double click or a retry
    // is the point: the endpoint and the Make scenario both key duplicate
    // protection on it. The server re-checks its shape and issues its own if
    // it is missing or odd.
    const SUBMISSION_ID = (() => {
      const stamp = Date.now().toString(36).toUpperCase();
      const rand = Math.random().toString(36).slice(2, 8).toUpperCase();
      return `ZPP-${stamp}-${rand}`;
    })();
    const opened = Date.now();

    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const alertBox = form.querySelector<HTMLElement>('[data-alert]')!;
    const sent = root.querySelector<HTMLElement>('[data-sent]')!;
    const mail = 'impactcenter@zeroplastic.lk';

    const MESSAGES: Record<string, string> = {
      company: 'Enter your company or organisation name.',
      organisation_type: 'Choose the type of organisation.',
      country: 'Enter your country.',
      contact_name: 'Enter a contact name.',
      email: 'Enter a valid email address.',
      whatsapp: 'Enter a WhatsApp number with its country code.',
      website: 'Enter a valid website address, or leave this blank.',
      estimated_traveller_volume: 'Choose an approximate band.',
      consent_contact: 'Please tick this box so we can reply to you.',
    };

    const control = (name: string) =>
      form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;

    function setError(name: string, on: boolean) {
      const el = control(name);
      const msg = form!.querySelector<HTMLElement>(`[data-err-for="${name}"]`);
      if (!el || !msg) return;
      if (on) {
        el.setAttribute('aria-invalid', 'true');
        el.setAttribute('aria-describedby', [el.getAttribute('aria-describedby'), msg.id || (msg.id = `err-${name}`)]
          .filter((v, i, a) => v && a.indexOf(v) === i).join(' '));
        msg.textContent = MESSAGES[name] || 'Please check this field.';
        msg.hidden = false;
      } else {
        el.removeAttribute('aria-invalid');
        msg.hidden = true;
        msg.textContent = '';
      }
    }

    function invalidFields(): string[] {
      const bad: string[] = [];
      const val = (n: string) => (control(n)?.value || '').trim();
      for (const n of ['company', 'country', 'contact_name', 'organisation_type', 'estimated_traveller_volume']) {
        if (!val(n)) bad.push(n);
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val('email'))) bad.push('email');
      const digits = val('whatsapp').replace(/\D/g, '');
      if (digits.length < 8 || digits.length > 15) bad.push('whatsapp');
      if (!(control('consent_contact') as HTMLInputElement).checked) bad.push('consent_contact');
      return bad;
    }

    function showAlert(html: string) {
      alertBox.innerHTML = html;
      alertBox.hidden = false;
      alertBox.focus();
    }

    const wa = form.dataset.wa || '';
    const fallback = `You can also email <a href="mailto:${mail}">${mail}</a> or <a href="${wa}" target="_blank" rel="noopener noreferrer">message us on WhatsApp</a>.`;

    let inFlight = false;

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      alertBox.hidden = true;
      if (inFlight) return;

      const all = Object.keys(MESSAGES);
      const bad = invalidFields();
      all.forEach((n) => setError(n, bad.includes(n)));
      if (bad.length) {
        showAlert(`Please check ${bad.length === 1 ? 'the highlighted field' : 'the highlighted fields'} and try again.`);
        control(bad[0])?.focus();
        return;
      }

      const body: Record<string, string> = { submission_id: SUBMISSION_ID };
      for (const el of Array.from(form.elements) as HTMLInputElement[]) {
        if (!el.name) continue;
        body[el.name] = el.type === 'checkbox' ? (el.checked ? 'true' : 'false') : el.value;
      }
      body.seconds_on_page = String(Math.round((Date.now() - opened) / 1000));
      body.page_url = location.origin + location.pathname;
      body.referrer = document.referrer;
      const q = new URLSearchParams(location.search);
      for (const k of ['utm_source', 'utm_medium', 'utm_campaign']) body[k] = q.get(k) || '';

      inFlight = true;
      submit.disabled = true;
      submit.textContent = 'Sending';

      try {
        const res = await fetch('/api/partner-enquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const json = await res.json().catch(() => null);

        if (res.ok && json && json.ok === true && json.submission_id) {
          // Only fixed-list choices are reported, never anything typed.
          track('one_kg_enquiry_submitted', {
            organisation_type: body.organisation_type,
            traveller_volume: body.estimated_traveller_volume,
          });
          form.hidden = true;
          sent.querySelector('[data-ref]')!.textContent = json.submission_id;
          sent.hidden = false;
          sent.focus();
          return;
        }

        if (res.status === 400 && json && Array.isArray(json.fields)) {
          all.forEach((n) => setError(n, json.fields.includes(n)));
          showAlert('Some details need another look. Please check the highlighted fields.');
          const first = json.fields.find((n: string) => control(n));
          if (first) control(first)?.focus();
        } else if (res.status === 503) {
          // The endpoint exists but is not wired to Make. Say so plainly
          // rather than claiming the enquiry was received.
          showAlert(`Online applications are not available at the moment, and nothing was sent. ${fallback}`);
        } else {
          showAlert(`We could not send your enquiry. Nothing has been recorded, so please try again, or ${fallback.charAt(0).toLowerCase()}${fallback.slice(1)}`);
        }
      } catch {
        showAlert(`We could not reach the server. Nothing has been recorded. ${fallback}`);
      }
      inFlight = false;
      submit.disabled = false;
      submit.textContent = 'Send partnership enquiry';
    });
  })();
</script>
