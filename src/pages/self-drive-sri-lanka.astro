  </div>
</BaseLayout>

<style>
  /* Scoped under .sd so no other route is affected. Tokens come from
     global.css; only what this page genuinely needs is added. */
  .sd {
    --sand: #fbf8f2;
    --sand-2: #f3ece0;
    --line-2: #e6dccb;
    --ink-1: #16261a;
    --muted-1: #5d6f64;
    /* Brand green fails AA as small text on sand, so links and small labels
       use a darkened tone of the same hue. */
    --accent-ink: #4d7219;
    background: var(--sand);
  }

  /* Constrain the prose, not the container, so these blocks keep the same
     left gutter as every other section instead of floating centred. */
  .sd .measure > * { max-width: 46rem; }

  /* The shared --green-600 eyebrow reads 2.86:1 on this page's cream panels,
