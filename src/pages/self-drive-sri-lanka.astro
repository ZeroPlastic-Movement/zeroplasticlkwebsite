<script>
  /**
   * Analytics and the mobile sticky bar.
   *
   * The tracker mirrors the helper already used by public/volunteer-sri-lanka.html:
   * gtag when it is there, dataLayer otherwise, and never throw, because a
   * blocked analytics script must not take the page down with it.
   */
  (() => {
    const root = document.querySelector('.sd');
    if (!root) return;

    function track(name: string, params?: Record<string, unknown>) {
      try {
        const w = window as unknown as {
          gtag?: (...a: unknown[]) => void;
          dataLayer?: Record<string, unknown>[];
        };
        if (typeof w.gtag === 'function') w.gtag('event', name, params || {});
        else if (w.dataLayer) w.dataLayer.push(Object.assign({ event: name }, params || {}));
      } catch {
        /* analytics must never break the page */
      }
    }

    track('self_drive_page_view', { page_location: location.pathname });

    // One delegated listener rather than one per control, so adding a CTA in
    // the template is enough to have it tracked.
    root.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement)?.closest?.('[data-ev]') as HTMLElement | null;
      if (!el) return;
      const name = el.dataset.ev;
      if (name) track(name, { link_text: (el.textContent || '').trim().slice(0, 80) });
    });

    // The sticky bar is only useful once the hero has scrolled away, and it is
    // shipped hidden so a no-JS visitor never gets a bar covering the footer.
    const sticky = root.querySelector<HTMLElement>('[data-sticky]');
    const hero = root.querySelector('.sd-hero');
    if (sticky && hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => { sticky.hidden = entry.isIntersecting; },
        { rootMargin: '0px' },
      ).observe(hero);
    }
  })();
</script>
