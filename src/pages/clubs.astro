---
import Figure from '../components/Figure.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CLUB_TYPES, EXTERNAL } from '../consts';
import { breadcrumbSchema, organizationSchema } from '../lib/schema';
---

<BaseLayout
  title="ZeroPlastic Clubs"
  description="A national network of young people turning concern into action. ZeroPlastic Clubs run across Sri Lankan universities, schools and communities."
  image="/images/clubs-network-800.jpg"
  schema={[
    organizationSchema(),
    breadcrumbSchema([
      { name: 'Home', url: '/' },
      { name: 'Clubs', url: '/clubs/' },
    ]),
  ]}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">ZeroPlastic Clubs</p>
      <h1>A national network of young people turning concern into action</h1>
      <p class="lede">
        Clubs are how the movement stays in a place after the campaign ends. They run across
        universities, schools and communities throughout Sri Lanka, led by the people who live
        there.
      </p>
      <p class="hero-actions">
        <a class="button" href={EXTERNAL.clubForm} rel="noopener noreferrer" target="_blank">
          Start a ZeroPlastic Club
        </a>
        <a class="button button--ghost" href={EXTERNAL.schoolClubForm} rel="noopener noreferrer" target="_blank">
          Register a School Club
        </a>
      </p>
      <p class="hero-note">Both registrations open our forms platform in a new tab.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="narrative">
          <p class="eyebrow">Backed by an islandwide network</p>
          <h2 class="section__title">Rooted in Sri Lanka's universities</h2>
          <p>
            ZeroPlastic works across an islandwide university network. Student-led clubs plan and
            run their own campaigns, clean-ups and education programmes, supported by the wider
            movement rather than directed by it.
          </p>
          <p>
            That structure is why a campaign can run in several districts on the same weekend.
            The people organising it already live there, already know the coastline or the canal
            in question, and already have a group ready to turn up.
          </p>
        </div>

        <Figure
          name="clubs-network"
          alt="A large group of ZeroPlastic volunteers celebrating beside bags of waste collected on World Cleanup Day in Sri Lanka."
          width={2000}
          height={1333}
          sizes="(max-width: 52rem) 100vw, 30rem"
        />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2 class="section__title">Three kinds of club</h2>
      <div class="tile-grid">
        {
          CLUB_TYPES.map((club) => (
            <div class="tile">
              <h3>{club.title}</h3>
              <p>{club.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Start one</p>
      <h2 class="section__title">Bring ZeroPlastic to your campus, school or community</h2>

      <div class="tile-grid tile-grid--2">
        <div class="tile">
          <h3>Start a ZeroPlastic Club</h3>
          <p>
            For university and community groups who want to set up a club and run campaigns,
            clean-ups and education work in their own area.
          </p>
          <p class="tile__cta">
            <a class="button" href={EXTERNAL.clubForm} rel="noopener noreferrer" target="_blank">
              Start a ZeroPlastic Club
            </a>
          </p>
        </div>

        <div class="tile">
          <h3>Register a ZeroPlastic School Club</h3>
          <p>
            For schools introducing students to plastic reduction through hands-on projects,
            education sessions and school-wide campaigns.
          </p>
          <p class="tile__cta">
            <a class="button" href={EXTERNAL.schoolClubForm} rel="noopener noreferrer" target="_blank">
              Register a School Club
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Not ready to lead a club?</h2>
          <p>
            You can volunteer with an existing club or campaign instead, locally or from abroad.
          </p>
        </div>
        <a class="button button--lg" href="/volunteers/">Volunteer with ZeroPlastic</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero-note {
    font-size: 0.87rem;
    color: var(--ink-300);
    margin: 0.85rem 0 0;
  }
  .narrative {
    max-width: 56ch;
  }
</style>
